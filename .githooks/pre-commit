#!/bin/sh
# Fail-closed secret scan of the staged changes. Installed by scripts/security/install-hooks.sh.

set -u
root=$(git rev-parse --show-toplevel)
. "$root/scripts/security/lib.sh"

sh "$root/scripts/security/check-config.sh" || exit 1
sh "$root/scripts/security/check-files.sh" --staged || exit 1

find_gitleaks
# Shared rules (check-config makes sure they exist), plus local-only extra rules if present.
for config in "$root/.gitleaks.toml" "$root/.gitleaks.local.toml"; do
  [ -f "$config" ] || continue
  "$GITLEAKS" git --pre-commit --staged --redact --verbose --no-banner --no-color --ignore-gitleaks-allow \
    --config "$config" --exit-code 1 "$root" \
    || block "gitleaks found a possible secret in the staged changes (value hidden above)"
done

echo "pre-commit: security checks passed"
