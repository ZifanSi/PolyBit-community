#!/bin/sh
# Fail-closed scan of every commit about to be pushed. Installed by scripts/security/install-hooks.sh.
# Git passes one line per ref on stdin: <local ref> <local sha> <remote ref> <remote sha>

set -u
root=$(git rev-parse --show-toplevel)
. "$root/scripts/security/lib.sh"

zero=0000000000000000000000000000000000000000

sh "$root/scripts/security/check-config.sh" || exit 1
find_gitleaks

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a remote branch: nothing to scan

  if [ "$remote_sha" = "$zero" ]; then
    range="$local_sha --not --remotes" # new branch: every commit the remote doesn't have yet
  else
    range="$remote_sha..$local_sha"
  fi

  sh "$root/scripts/security/check-files.sh" --tree "$local_sha" || exit 1

  "$GITLEAKS" git --log-opts="$range" --redact --verbose --no-banner --no-color --ignore-gitleaks-allow \
    --config "$root/.gitleaks.toml" --exit-code 1 "$root" \
    || block "gitleaks found a possible secret in commits for $remote_ref (value hidden above)"
done

echo "pre-push: security checks passed"
