# Copy to .env and fill in. Amounts are in PB (decimals allowed, up to 6 places).

# This file is a template with placeholders only. Your real .env is gitignored: never commit it,
# never paste its contents into issues or chat, and rotate the bot token if it ever leaks.

# Required
PB_DISCORD_TOKEN=
# Local install: your PostgreSQL connection string. (Docker builds this from PB_DB_PASSWORD.)
PB_DATABASE_URL=postgresql://polybit:CHANGE_ME@localhost:5432/polybit

# Docker only: password for the bundled PostgreSQL. Use a long random value, e.g.
#   python -c "import secrets; print(secrets.token_hex(24))"
PB_DB_PASSWORD=

# Comma-separated Discord user IDs allowed to use /pbadmin (mint, burn, freeze, audit).
PB_ADMIN_IDS=

# Optional: sync slash commands to one server only for instant updates while developing.
PB_DEV_GUILD_ID=

# Economy
PB_SIGNUP_GRANT=100
PB_DAILY_AMOUNT=25
PB_DAILY_STREAK_BONUS=5
PB_DAILY_STREAK_MAX=7
PB_DAILY_COOLDOWN_HOURS=20
PB_DAILY_STREAK_WINDOW_HOURS=48
# Fee on /send and /sendmany in basis points (100 = 1%), paid by the sender into the treasury.
PB_TRANSFER_FEE_BPS=0
# Payments at or above this amount require a confirmation click.
PB_PAY_CONFIRM_THRESHOLD=1000

# Extensions to load, comma-separated module names (see README).
PB_EXTENSIONS=
# HTTP port for extension routes. 0 keeps it off. Keep it on localhost and put HTTPS in front.
PB_API_HOST=127.0.0.1
PB_API_PORT=0
